{
  "version": "2026.11.8",
  "_readme": "Edit this file to add, remove or tune job sources; no code changes needed. Every URL must be https. 'rest-json' reads a JSON API, 'rss' reads RSS 2.0 or Atom. A feed with 'instances' is expanded once per instance ({company} in the url is replaced by the instance's vars.company). Field paths use dots (employer.name); a list means 'first one that has a value'. Check each source's terms before enabling it; 'terms' records what I found. 'autoSync' syncs in the background while the app is running (set enabled to false to sync only with the button, or set the environment variable AUTO_SYNC=off).",
  "settings": {
    "autoSync": { "enabled": true, "startupDelaySeconds": 30, "intervalMinutes": 180 },
    "userAgent": "job-search-local/1.0 (+https://github.com/Shuvo991/job-search)",
    "requestTimeoutMs": 15000,
    "maxResponseBytes": 12000000,
    "maxRedirects": 3,
    "concurrency": 3,
    "maxItemsPerFeed": 500,
    "failureBackoffMinutes": 5
  },
  "feeds": [
    {
      "id": "jobtech",
      "name": "Arbetsförmedlingen (JobTech)",
      "type": "rest-json",
      "enabled": true,
      "url": "https://jobsearch.api.jobtechdev.se/search",
      "query": { "occupation-field": "apaJ_2ja_LuF", "limit": 100, "sort": "pubdate-desc" },
      "minIntervalMinutes": 60,
      "attribution": "Source: Arbetsförmedlingen / JobTech Dev (Platsbanken)",
      "terms": "Free public API, no key. occupation-field apaJ_2ja_LuF is 'Data/IT'. Most ads are in Swedish and are removed by the language filter; the 'english' instance asks for ads that mention English.",
      "instances": [
        { "id": "it", "name": "Arbetsförmedlingen (IT)" },
        { "id": "english", "name": "Arbetsförmedlingen (IT, English)", "query": { "q": "english" } }
      ],
      "itemsPath": "hits",
      "fields": {
        "id": "id",
        "title": "headline",
        "company": ["employer.name", "employer.workplace"],
        "url": "webpage_url",
        "applyUrl": ["application_details.url", "webpage_url"],
        "description": ["description.text_formatted", "description.text"],
        "location": ["workplace_address.municipality", "workplace_address.city", "workplace_address.region"],
        "country": "workplace_address.country",
        "postedAt": "publication_date",
        "employmentType": "working_hours_type.label"
      }
    },
    {
      "id": "jobtech-roles",
      "name": "Arbetsförmedlingen (JobTech)",
      "type": "rest-json",
      "enabled": true,
      "url": "https://jobsearch.api.jobtechdev.se/search",
      "query": { "limit": 100, "sort": "pubdate-desc" },
      "minIntervalMinutes": 120,
      "attribution": "Source: Arbetsförmedlingen / JobTech Dev (Platsbanken)",
      "terms": "Same free public API as the 'jobtech' feed, but one search per target role across ALL occupation fields (the 'jobtech' feed only reads the Data/IT field, so it misses product, project and analyst roles filed under other fields). Swedish-language ads are still removed by the language filter.",
      "instances": [
        { "id": "product-manager", "name": "Arbetsförmedlingen (product manager)", "query": { "q": "product manager" } },
        { "id": "product-owner", "name": "Arbetsförmedlingen (product owner)", "query": { "q": "product owner" } },
        { "id": "product-analyst", "name": "Arbetsförmedlingen (product analyst)", "query": { "q": "product analyst" } },
        { "id": "project-manager", "name": "Arbetsförmedlingen (project manager)", "query": { "q": "project manager" } },
        { "id": "software-developer", "name": "Arbetsförmedlingen (software developer)", "query": { "q": "software developer" } },
        { "id": "web-developer", "name": "Arbetsförmedlingen (web developer)", "query": { "q": "web developer" } },
        { "id": "software-engineer", "name": "Arbetsförmedlingen (software engineer)", "query": { "q": "software engineer" } },
        { "id": "ai-engineer", "name": "Arbetsförmedlingen (AI engineer)", "query": { "q": "AI engineer" } },
        { "id": "ml-engineer", "name": "Arbetsförmedlingen (machine learning engineer)", "query": { "q": "machine learning engineer" } }
      ],
      "itemsPath": "hits",
      "fields": {
        "id": "id",
        "title": "headline",
        "company": ["employer.name", "employer.workplace"],
        "url": "webpage_url",
        "applyUrl": ["application_details.url", "webpage_url"],
        "description": ["description.text_formatted", "description.text"],
        "location": ["workplace_address.municipality", "workplace_address.city", "workplace_address.region"],
        "country": "workplace_address.country",
        "postedAt": "publication_date",
        "employmentType": "working_hours_type.label"
      }
    },
    {
      "id": "arbeitnow-more",
      "name": "Arbeitnow",
      "type": "rest-json",
      "enabled": true,
      "url": "https://www.arbeitnow.com/api/job-board-api",
      "minIntervalMinutes": 180,
      "attribution": "Jobs via Arbeitnow (https://www.arbeitnow.com)",
      "terms": "Older pages (2 and 3) of the same Arbeitnow API as the 'arbeitnow' feed, which only reads page 1. No key needed.",
      "instances": [
        { "id": "page-2", "name": "Arbeitnow (page 2)", "query": { "page": 2 } },
        { "id": "page-3", "name": "Arbeitnow (page 3)", "query": { "page": 3 } }
      ],
      "itemsPath": "data",
      "fields": {
        "id": "slug",
        "title": "title",
        "company": "company_name",
        "url": "url",
        "applyUrl": "url",
        "description": "description",
        "location": "location",
        "postedAt": "created_at",
        "employmentType": "job_types",
        "workMode": "remote"
      }
    },
    {
      "id": "jobicy",
      "name": "Jobicy",
      "type": "rest-json",
      "enabled": true,
      "url": "https://jobicy.com/api/v2/remote-jobs",
      "query": { "count": 100, "geo": "europe" },
      "minIntervalMinutes": 240,
      "attribution": "Jobs via Jobicy (https://jobicy.com)",
      "terms": "Jobicy asks you to keep the Jobicy job URL as the source and apply link, and to query only a few times a day. Both are done here.",
      "defaults": { "workMode": "REMOTE" },
      "itemsPath": "jobs",
      "fields": {
        "id": "id",
        "title": "jobTitle",
        "company": "companyName",
        "url": "url",
        "applyUrl": "url",
        "description": ["jobDescription", "jobExcerpt"],
        "location": "jobGeo",
        "postedAt": "pubDate",
        "employmentType": "jobType",
        "salaryMin": ["salaryMin", "annualSalaryMin"],
        "salaryMax": ["salaryMax", "annualSalaryMax"],
        "salaryCurrency": "salaryCurrency",
        "salaryPeriod": "salaryPeriod"
      }
    },
    {
      "id": "devglobaljobs",
      "name": "Dev Global Jobs",
      "type": "rest-json",
      "enabled": false,
      "url": "https://devglobaljobs.com/api/v1/jobs",
      "minIntervalMinutes": 240,
      "attribution": "Powered by Dev Global Jobs",
      "terms": "DISABLED: when I checked (2026-11-08) this URL was blocked by the site's robots.txt and I could not see the response format, so the field mapping below is a guess. Get permission or API documentation from the site, fix the mapping, then set enabled to true.",
      "itemsPath": "jobs",
      "fields": {
        "id": ["id", "slug"],
        "title": ["title", "job_title"],
        "company": ["company", "company_name", "company.name"],
        "url": ["url", "link", "apply_url"],
        "applyUrl": ["apply_url", "url"],
        "description": ["description", "content"],
        "location": ["location", "city"],
        "country": "country",
        "postedAt": ["posted_at", "published_at", "created_at"]
      }
    },
    {
      "id": "startup-jobs",
      "name": "Startup Jobs",
      "type": "rss",
      "enabled": true,
      "url": "https://startup.jobs/feeds/jobs",
      "minIntervalMinutes": 60,
      "attribution": "Jobs via Startup Jobs (https://startup.jobs)",
      "terms": "Public RSS 2.0 feed (ttl 15 minutes). Item titles look like 'Role at Company'; the company is split off the title.",
      "titleCompanySeparator": " at ",
      "fields": {
        "id": ["guid", "link"],
        "title": "title",
        "url": ["guid", "link"],
        "description": ["content:encoded", "description"],
        "postedAt": "pubDate"
      }
    },
    {
      "id": "himalayas",
      "name": "Himalayas",
      "type": "rss",
      "enabled": true,
      "url": "https://himalayas.app/jobs/rss",
      "minIntervalMinutes": 1440,
      "attribution": "Jobs via Himalayas (https://himalayas.app)",
      "terms": "Feed ttl is 24 hours, so it is fetched at most daily. Himalayas' terms say to identify Himalayas as the source with a link, and not to pass jobs on to other job boards or aggregators: fine for your private local board; remove this feed if you ever make the board public.",
      "defaults": { "workMode": "REMOTE" },
      "fields": {
        "id": ["guid", "link"],
        "title": "title",
        "company": "himalayasJobs:companyName",
        "url": ["guid", "link"],
        "description": ["content:encoded", "description"],
        "location": "himalayasJobs:locationRestriction",
        "postedAt": "pubDate"
      }
    },
    {
      "id": "teamtailor",
      "name": "Teamtailor",
      "type": "rss",
      "enabled": true,
      "url": "https://{company}.teamtailor.com/jobs.rss",
      "minIntervalMinutes": 120,
      "terms": "Teamtailor documents <career site>/jobs.rss for syndication. Add a Swedish company by adding an instance whose vars.company is its Teamtailor subdomain (the part before .teamtailor.com). Companies with their own domain can still be reached through the subdomain; redirects to *.teamtailor.com are followed. Slugs below are from public career sites; a wrong slug just logs an error for that feed.",
      "allowedHosts": ["*.teamtailor.com"],
      "instances": [
        { "id": "tibber", "company": "Tibber", "vars": { "company": "tibber" } },
        { "id": "hemnet", "company": "Hemnet", "vars": { "company": "hemnet" } },
        { "id": "storytel", "company": "Storytel", "vars": { "company": "storytel" } },
        { "id": "hedvig", "company": "Hedvig", "vars": { "company": "hedvig" } }
      ],
      "fields": {
        "id": ["guid", "link"],
        "title": "title",
        "url": ["link", "guid"],
        "description": ["description", "content:encoded"],
        "location": ["tt:locations.tt:location.tt:city", "tt:locations.tt:location.tt:name"],
        "country": "tt:locations.tt:location.tt:country",
        "workMode": "remoteStatus",
        "postedAt": "pubDate"
      }
    },
