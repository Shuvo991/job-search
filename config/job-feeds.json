      "terms": "Remotive asks for at most 4 fetches a day, a link back to Remotive on every job, and that jobs are not passed on to other job boards (LinkedIn, Google Jobs, Jooble). Its jobs are delayed by 24 hours. Two categories x 2 fetches a day = 4 a day. Fine for a private board; do not make the board public with this feed enabled.",
      "defaults": { "workMode": "REMOTE" },
      "instances": [
        { "id": "software-dev", "name": "Remotive (software dev)", "query": { "category": "software-dev" } },
        { "id": "product", "name": "Remotive (product)", "query": { "category": "product" } }
      ],
