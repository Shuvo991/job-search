{
  "version": "2026.11.8",
  "_readme": "Rules for the location gate (src/lib/geo-filter.ts). The board keeps (1) jobs located in Europe and (2) remote jobs that candidates from anywhere can apply for. Everything is matched ignoring case and accents, on whole words ('Göteborg' = 'goteborg'). 'policy' switches behaviour; the lists are free to edit. Turkey, Russia and Belarus are deliberately not in the Europe lists (add them if you want them).",
  "policy": {
    "_remoteTiedToEurope": "keep = a remote job restricted to Europe (or to a European country, or a region list that includes Europe, like 'EMEA, USA, Canada') counts as a European job. reject = remote jobs are only kept when open worldwide.",
    "remoteTiedToEurope": "keep",
    "_unspecifiedRemote": "What to do with a remote job that names no place at all. reject = drop it, unless its feed says blank means worldwide (worldwideWhenNoLocation) or the description clearly says worldwide.",
    "unspecifiedRemote": "reject",
    "_checkDescription": "Look for 'must be based in the United States' style limits in the description of remote jobs that would otherwise be kept as worldwide.",
    "checkDescription": true
  },
