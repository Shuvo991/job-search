# SQLite database file, relative to the project root. The data/ folder must exist.
DATABASE_URL="file:./data/dev.db"

# Local Ollama service (must be a localhost address; no cloud AI APIs are used)
OLLAMA_BASE_URL="http://localhost:11434"

# Resume / document uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="5242880"
