# SQLite database file, relative to the project root. The data/ folder must exist.
DATABASE_URL="file:./data/dev.db"

# Local Ollama service (must be a localhost address; no cloud AI APIs are used)
OLLAMA_BASE_URL="http://localhost:11434"

# Tailoring (Phase 4). All optional; these are the defaults.
# Model for CV / cover-letter tailoring: llama3.2 or qwen2.5 (e.g. qwen2.5:7b gives better results)
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_MS="240000"
OLLAMA_NUM_CTX="16384"
OLLAMA_NUM_PREDICT="3072"

# Resume / document uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES="5242880"
